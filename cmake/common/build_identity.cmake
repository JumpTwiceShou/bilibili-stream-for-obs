# Regenerated at build time so local source edits cannot retain an apparently clean build ID.
set(build_commit "unknown")
find_program(build_git git)
if(build_git)
  execute_process(COMMAND "${build_git}" -C "${SOURCE_ROOT}" rev-parse --short=12 HEAD
    OUTPUT_VARIABLE build_head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE build_git_result)
  if(build_git_result EQUAL 0 AND build_head MATCHES "^[0-9a-fA-F]+$")
    set(build_commit "${build_head}")
    execute_process(COMMAND "${build_git}" -C "${SOURCE_ROOT}" status --porcelain --untracked-files=normal
      -- src cmake data CMakeLists.txt buildspec.json
      OUTPUT_VARIABLE build_changes ERROR_QUIET RESULT_VARIABLE build_status_result)
    if(NOT build_status_result EQUAL 0)
      string(APPEND build_commit "-unknown")
    elseif(NOT build_changes STREQUAL "")
      string(APPEND build_commit "-dirty")
    endif()
  endif()
endif()
set(build_presets "no")
if(PRIVATE_PRESETS)
  set(build_presets "yes")
endif()
set(build_content "#pragma once\n#define BILIBILI_BUILD_COMMIT \"${build_commit}\"\n#define BILIBILI_BUILD_PRIVATE_PRESETS \"${build_presets}\"\n")
set(build_previous "")
if(EXISTS "${OUTPUT_HEADER}")
  file(READ "${OUTPUT_HEADER}" build_previous)
endif()
if(NOT build_previous STREQUAL build_content)
  file(WRITE "${OUTPUT_HEADER}" "${build_content}")
endif()
